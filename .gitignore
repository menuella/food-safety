# Go
packages/go/*.test

# Rust. Cargo.lock is not committed: this is a library, so the lockfile that
# matters is the consuming binary's, and committing ours would only pin the
# dev-dependency used by the tests.
packages/rust/target/
packages/rust/Cargo.lock

# Ruby. Gemfile.lock is not committed for the same reason as Cargo.lock: this
# is a library, so the lockfile that matters is the consuming application's.
packages/ruby/*.gem
packages/ruby/Gemfile.lock
packages/ruby/.bundle/
packages/ruby/pkg/
